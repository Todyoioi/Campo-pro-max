    ESP = true,
    Skeleton = true,
    Names = true,
    Distance = true,
    TeamCheck = true,
    AimAssist = false,

    AimRadius = 250,
    Smoothness = 0.20,
    ScanInterval = 2
}

local Colors = {
    Ally = Color3.fromRGB(0, 255, 120),
    Enemy = Color3.fromRGB(255, 65, 65),
    UI = Color3.fromRGB(150, 80, 255)
}

local tracked = {}
local connections = {}
local alive = true

-- Limpa elementos antigos
local oldGui = Player:WaitForChild("PlayerGui"):FindFirstChild("BlackPanelPro")
if oldGui then
    oldGui:Destroy()
end

local function isNPC(model)
    if not model:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(model) then return false end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local head = model:FindFirstChild("Head")
    local root = model:FindFirstChild("HumanoidRootPart")

    return humanoid ~= nil
        and humanoid.Health > 0
        and head ~= nil
        and root ~= nil
end

local function isAlly(model)
    if model:GetAttribute("IsAlly") == true then
        return true
    end

    if not Config.TeamCheck then
        return false
    end

    local npcTeam = model:GetAttribute("TeamName")
    local playerTeam = Player:GetAttribute("TeamName")

    if Player.Team then
        playerTeam = Player.Team.Name
    end

    if npcTeam and playerTeam then
        return npcTeam == playerTeam
    end

    local teamValue = model:FindFirstChild("Team")
    if teamValue and teamValue:IsA("StringValue") then
        return teamValue.Value == playerTeam
    end

    return false
end

local function getColor(model)
    return isAlly(model) and Colors.Ally or Colors.Enemy
end

local function createHighlight(model)
    local highlight = Instance.new("Highlight")
    highlight.Name = "BlackPanelHighlight"
    highlight.Adornee = model
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 0.75
    highlight.OutlineTransparency = 0
    highlight.Parent = model
    return highlight
end

local function createBillboard(model)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "BlackPanelInfo"
    billboard.Adornee = model:FindFirstChild("Head")
    billboard.Size = UDim2.fromOffset(180, 45)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = model

    local label = Instance.new("TextLabel")
    label.Name = "Info"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextStrokeTransparency = 0.2
    label.Parent = billboard

    return billboard, label
end

local function createSkeleton(model)
    local folder = Instance.new("Folder")
    folder.Name = "BlackPanelSkeleton"
    folder.Parent = model

    local pairsList = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"},
        {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"},
        {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"}
    }

    -- Compatibilidade com R6
    local r6 = {
        {"Head", "Torso"},
        {"Torso", "Left Arm"},
        {"Torso", "Right Arm"},
        {"Torso", "Left Leg"},
        {"Torso", "Right Leg"}
    }

    local function addBeam(partA, partB)
        local a = model:FindFirstChild(partA)
        local b = model:FindFirstChild(partB)

        if not a or not b then return end

        local att0 = Instance.new("Attachment")
        att0.Parent = a

        local att1 = Instance.new("Attachment")
        att1.Parent = b

        local beam = Instance.new("Beam")
        beam.Attachment0 = att0
        beam.Attachment1 = att1
        beam.Width0 = 0.035
        beam.Width1 = 0.035
        beam.FaceCamera = true
        beam.Parent = folder
    end

    for _, pair in ipairs(pairsList) do
        addBeam(pair[1], pair[2])
    end

    for _, pair in ipairs(r6) do
        addBeam(pair[1], pair[2])
    end
end

local function removeNPC(model)
    local data = tracked[model]
    if not data then return end

    for _, object in ipairs(data.objects) do
        if object and object.Parent then
            object:Destroy()
        end
    end

    tracked[model] = nil
end

local function addNPC(model)
    if tracked[model] or not isNPC(model) then return end

    local objects = {}

    local highlight = createHighlight(model)
    table.insert(objects, highlight)

    local billboard, label = createBillboard(model)
    table.insert(objects, billboard)

    createSkeleton(model)
    local skeleton = model:FindFirstChild("BlackPanelSkeleton")
    if skeleton then
        table.insert(objects, skeleton)
    end

    tracked[model] = {
        highlight = highlight,
        billboard = billboard,
        label = label,
        objects = objects
    }
end

local function scanNPCs()
    for _, model in ipairs(Workspace:GetDescendants()) do
        if isNPC(model) then
            addNPC(model)
        end
    end

    for model in pairs(tracked) do
        if not model.Parent or not isNPC(model) then
            removeNPC(model)
        end
    end
end


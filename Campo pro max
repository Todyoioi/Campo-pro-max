--[[
    CAMPO PRO MAX V4
    Sistema de treinamento para jogo próprio no Roblox Studio.

    Requisitos:
    - RemoteEvent "CampoProEvent" em ReplicatedStorage
    - NPCs de treinamento com tag "TrainingNPC"
    - Aliados e inimigos identificados por Teams
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local remote = ReplicatedStorage:WaitForChild("CampoProEvent")

local speed = 16
local jump = 50
local espEnabled = false
local aimEnabled = false
local protectionEnabled = false
local aimRadius = 180

-- INTERFACE
local gui = Instance.new("ScreenGui")
gui.Name = "CampoProMax"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local main = Instance.new("Frame")
main.Size = UDim2.fromOffset(620, 390)
main.Position = UDim2.new(0.5, -310, 0.5, -195)
main.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
main.BorderSizePixel = 0
main.Parent = gui

Instance.new("UICorner", main).CornerRadius = UDim.new(0, 12)

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(65, 65, 80)
stroke.Thickness = 1.5
stroke.Parent = main

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 55)
title.BackgroundColor3 = Color3.fromRGB(20, 20, 27)
title.Text = "CAMPO PRO MAX"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 23
title.Parent = main
Instance.new("UICorner", title).CornerRadius = UDim.new(0, 12)

local sidebar = Instance.new("Frame")
sidebar.Position = UDim2.fromOffset(10, 70)
sidebar.Size = UDim2.fromOffset(175, 305)
sidebar.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
sidebar.Parent = main
Instance.new("UICorner", sidebar).CornerRadius = UDim.new(0, 8)

local content = Instance.new("Frame")
content.Position = UDim2.fromOffset(195, 70)
content.Size = UDim2.fromOffset(415, 305)
content.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
content.Parent = main
Instance.new("UICorner", content).CornerRadius = UDim.new(0, 8)

local pages = {}

local function createPage(name)
    local page = Instance.new("Frame")
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = content

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 9)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page

    pages[name] = page
    return page
end

local function showPage(name)
    for pageName, page in pairs(pages) do
        page.Visible = pageName == name
    end
end

local function button(parent, text, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -16, 0, 42)
    b.Position = UDim2.fromOffset(8, 0)
    b.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Text = text
    b.Font = Enum.Font.GothamSemibold
    b.TextSize = 14
    b.AutoButtonColor = true
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)

    b.MouseButton1Click:Connect(callback)
    return b
end

local function label(parent, text)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -16, 0, 30)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Color3.fromRGB(190, 190, 205)
    l.Font = Enum.Font.Gotham
    l.TextSize = 14
    l.Parent = parent
    return l
end

local combat = createPage("COMBATE")
local movement = createPage("MOVIMENTO")
local visual = createPage("VISUAL ESP")
local aim = createPage("AIM ASSIST")

-- COMBATE
label(combat, "SISTEMA DE TREINAMENTO")

button(combat, "Proteção: DESLIGADA", function()
    protectionEnabled = not protectionEnabled
    remote:FireServer("Protection", protectionEnabled)
end)

button(combat, "Treino: mostrar instruções", function()
    print("Configure os alvos e o sistema de dano no servidor.")
end)

-- MOVIMENTO
label(movement, "CONTROLE DE MOVIMENTO")

local speedLabel = label(movement, "Velocidade: 16")
button(movement, "Aumentar velocidade +", function()
    speed = math.clamp(speed + 2, 16, 100)
    speedLabel.Text = "Velocidade: " .. speed
    remote:FireServer("Speed", speed)
end)

button(movement, "Diminuir velocidade -", function()
    speed = math.clamp(speed - 2, 16, 100)
    speedLabel.Text = "Velocidade: " .. speed
    remote:FireServer("Speed", speed)
end)

local jumpLabel = label(movement, "Pulo: 50")
button(movement, "Aumentar pulo +", function()
    jump = math.clamp(jump + 5, 50, 150)
    jumpLabel.Text = "Pulo: " .. jump
    remote:FireServer("Jump", jump)
end)

button(movement, "Diminuir pulo -", function()
    jump = math.clamp(jump - 5, 50, 150)
    jumpLabel.Text = "Pulo: " .. jump
    remote:FireServer("Jump", jump)
end)

-- ESP
label(visual, "VISUALIZAÇÃO DE JOGADORES")

button(visual, "ESP: LIGAR / DESLIGAR", function()
    espEnabled = not espEnabled
end)

local highlights = {}

local function updateESP()
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and other.Character then
            local character = other.Character
            local highlight = highlights[other]

            if not highlight or highlight.Parent ~= character then
                if highlight then
                    highlight:Destroy()
                end

                highlight = Instance.new("Highlight")
                highlight.Parent = character
                highlights[other] = highlight
            end

            highlight.Enabled = espEnabled

            local ally = player.Team ~= nil
                and other.Team ~= nil
                and player.Team == other.Team

            highlight.FillColor = ally
                and Color3.fromRGB(0, 255, 100)
                or Color3.fromRGB(255, 55, 55)

            highlight.OutlineColor = highlight.FillColor
            highlight.FillTransparency = 0.55
        end
    end
end

Players.PlayerRemoving:Connect(function(other)
    if highlights[other] then
        highlights[other]:Destroy()
        highlights[other] = nil
    end
end)

-- AIM ASSIST PARA NPCs DE TREINAMENTO
label(aim, "MIRA DE TREINAMENTO")

button(aim, "Aim Assist: LIGAR / DESLIGAR", function()
    aimEnabled = not aimEnabled
end)

label(aim, "Raio da mira: 180 pixels")

RunService.RenderStepped:Connect(function()
    updateESP()

    if not aimEnabled then
        return
    end

    local closest
    local shortest = aimRadius

    for _, npc in ipairs(CollectionService:GetTagged("TrainingNPC")) do
        local humanoid = npc:FindFirstChildOfClass("Humanoid")
        local head = npc:FindFirstChild("Head")

        if humanoid and head and humanoid.Health > 0 then
            local screenPos, visible = camera:WorldToViewportPoint(head.Position)

            if visible then
                local center = camera.ViewportSize / 2
                local distance = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude

                if distance < shortest then
                    shortest = distance
                    closest = head
                end
            end
        end
    end

    if closest then
        local target = CFrame.lookAt(camera.CFrame.Position, closest.Position)
        camera.CFrame = camera.CFrame:Lerp(target, 0.12)
    end
end)

-- CATEGORIAS
local categories = {
    "COMBATE",
    "MOVIMENTO",
    "VISUAL ESP",
    "AIM ASSIST"
}

for _, name in ipairs(categories) do
    button(sidebar, name, function()
        showPage(name)
    end)
end

showPage("COMBATE")

-- ANIMAÇÃO E TECLA G
local opened = true
local UserInputService = game:GetService("UserInputService")

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.G then
        opened = not opened

        local targetSize = opened
            and UDim2.fromOffset(620, 390)
            or UDim2.fromOffset(0, 0)

        TweenService:Create(
            main,
            TweenInfo.new(0.25, Enum.EasingStyle.Quart),
            {Size = targetSize}
        ):Play()
    end
end)

print("CAMPO PRO MAX V4 carregado!")

local function createButton(text, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 38)
    button.BackgroundColor3 = Color3.fromRGB(39, 34, 53)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Text = text
    button.Font = Enum.Font.GothamSemibold
    button.TextSize = 13
    button.AutoButtonColor = true
    button.Parent = content

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 7)
    c.Parent = button

    button.MouseButton1Click:Connect(callback)
    return button
end

local function toggleButton(name, key)
    local button

    local function refresh()
        button.Text = name .. ": " .. (Config[key] and "ON" or "OFF")
        button.BackgroundColor3 = Config[key]
            and Color3.fromRGB(49, 95, 76)
            or Color3.fromRGB(39, 34, 53)
    end

    button = createButton("", function()
        Config[key] = not Config[key]
        refresh()
    end)

    refresh()
end

toggleButton("ESP", "ESP")
toggleButton("Esqueleto", "Skeleton")
toggleButton("Nomes", "Names")
toggleButton("Distância", "Distance")
toggleButton("Team Check", "TeamCheck")
toggleButton("Aim Assist NPC", "AimAssist")

createButton("Fechar painel", function()
    main.Visible = false
end)

-- Tecla G abre/fecha o painel
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.G then
        main.Visible = not main.Visible
    end
end)

-- Atualização visual
local updateTimer = 0

connections.render = RunService.RenderStepped:Connect(function(deltaTime)
    updateTimer += deltaTime

    for model, data in pairs(tracked) do
        if model.Parent then
            local color = getColor(model)
            local root = model:FindFirstChild("HumanoidRootPart")
            local humanoid = model:FindFirstChildOfClass("Humanoid")

            if data.highlight then
                data.highlight.Enabled = Config.ESP
                data.highlight.FillColor = color
                data.highlight.OutlineColor = color
            end

            if data.billboard then
                data.billboard.Enabled = Config.Names or Config.Distance

                local distanceText = ""
                if Config.Distance and root and Player.Character
                    and Player.Character:FindFirstChild("HumanoidRootPart") then

                    local playerRoot = Player.Character.HumanoidRootPart
                    local distance = (root.Position - playerRoot.Position).Magnitude
                    distanceText = "\n" .. math.floor(distance) .. " studs"
                end

                data.label.Text = (Config.Names and model.Name or "") .. distanceText
                data.label.TextColor3 = color
            end

            local skeleton = model:FindFirstChild("BlackPanelSkeleton")
            if skeleton then
                for _, beam in ipairs(skeleton:GetChildren()) do
                    if beam:IsA("Beam") then
                        beam.Enabled = Config.Skeleton
                        beam.Color = ColorSequence.new(color)
                    end
                end
            end

            if humanoid and humanoid.Health <= 0 then
                removeNPC(model)
            end
        end
    end

    -- Aim Assist somente para NPCs
    if Config.AimAssist and Player.Character then
        local bestNPC = nil
        local bestDistance = Config.AimRadius
        local center = Camera.ViewportSize / 2

        for model in pairs(tracked) do
            if model.Parent and not isAlly(model) then
                local head = model:FindFirstChild("Head")
                local humanoid = model:FindFirstChildOfClass("Humanoid")

                if head and humanoid and humanoid.Health > 0 then
                    local screenPos, visible = Camera:WorldToViewportPoint(head.Position)

                    if visible then
                        local distance = (
                            Vector2.new(screenPos.X, screenPos.Y) - center
                        ).Magnitude

                        if distance < bestDistance then
                            bestDistance = distance
                            bestNPC = head
                        end
                    end
                end
            end
        end

        if bestNPC then
            local target = CFrame.lookAt(Camera.CFrame.Position, bestNPC.Position)
            Camera.CFrame = Camera.CFrame:Lerp(target, Config.Smoothness)
        end
    end
end)

-- Procura NPCs periodicamente
task.spawn(function()
    while alive and gui.Parent do
        scanNPCs()
        task.wait(Config.ScanInterval)
    end
end)

print("BLACK PANEL NPC carregado! Aperte G para abrir/fechar.")
